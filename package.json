{
  "name": "youngbloods-org",
  "private": true,
  "sideEffects": false,
  "type": "module",
  "scripts": {
    "build": "vite build",
    "dev": "vite",
    "deploy": "gh workflow run deploy.yml",
    "deploy:watch": "gh run watch --exit-status",
    "lint": "biome lint --write --error-on-warnings .",
    "format": "biome format --write .",
    "preview": "vite preview",
    "typecheck": "tsc",
    "checks": "bun run format && bun run lint && bun run typecheck",
    "yolo": "bun run checks && git add . && git commit -m 'Update committed without description' && git push"
  },
  "dependencies": {
    "@tanstack/react-router": "^1.170.28",
    "@tanstack/react-start": "^1.168.45",
    "markdown-it": "^15.0.0",
    "markdown-it-footnote": "^4.0.0",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "remark-frontmatter": "^5.0.0",
    "remark-mdx-frontmatter": "^5.2.0",
    "remark-smartypants": "^3.0.3"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.5.8",
    "@mdx-js/mdx": "^3.1.1",
    "@mdx-js/react": "^3.1.1",
    "@tailwindcss/vite": "^4.3.3",
    "@tanstack/router-plugin": "^1.168.31",
    "@types/markdown-it": "^14.1.2",
    "@types/mdast": "^4.0.4",
    "@types/node": "^26.2.0",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.4",
    "@types/rss": "^0.0.32",
    "@vitejs/plugin-react": "^6.0.5",
    "marked": "^18.0.9",
    "rehype-highlight": "^7.0.2",
    "rehype-prism-plus": "^2.0.2",
    "remark-gfm": "^4.0.1",
    "rss": "^1.2.2",
    "tailwindcss": "^4.3.3",
    "typescript": "^7.0.2",
    "unist-util-visit": "^5.1.0",
    "vite": "^8.2.1",
    "yaml": "^2.9.0"
  },
  "overrides": {
    "js-yaml": "5.3.0"
  },
  "engines": {
    "node": ">=20.0.0"
  }
}
